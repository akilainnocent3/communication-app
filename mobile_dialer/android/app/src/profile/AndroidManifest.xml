<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application>
        <!-- Performance seeding (src/devtools, debug and profile builds only). DUMP: only adb shell can send it. -->
        <receiver android:name=".devtools.SeedReceiver" android:exported="true" android:permission="android.permission.DUMP" />
    </application>
</manifest>
