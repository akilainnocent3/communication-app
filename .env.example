# Copy to .env (never commit .env). Every value here is optional for local `docker compose up`;
# the ones marked REQUIRED IN PRODUCTION must be set when DJANGO_SETTINGS_MODULE=config.settings.prod.

# --- Django -------------------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev          # config.settings.prod on the server
DJANGO_SECRET_KEY=                                  # REQUIRED IN PRODUCTION: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend    # add your domain, e.g. mail.company.co.tz
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000   # https://mail.company.co.tz in production
COOKIE_SECURE=false                                 # prod settings force secure cookies
SESSION_COOKIE_AGE=43200
TIME_ZONE=Africa/Dar_es_Salaam
LOG_LEVEL=INFO
GUNICORN_WORKERS=3
CELERY_CONCURRENCY=2

# --- Database / Redis (docker-compose builds DATABASE_URL and REDIS_URL from these) --------------------
POSTGRES_USER=cm
POSTGRES_PASSWORD=cm                                # REQUIRED IN PRODUCTION: a strong password
POSTGRES_DB=cm
# DATABASE_URL=postgres://cm:cm@127.0.0.1:5432/cm   # manual (non-Docker) setup only
# REDIS_URL=redis://127.0.0.1:6379/0                # manual setup; empty = tasks run inline, no worker needed

# --- Product ------------------------------------------------------------------------------------------
COMPANY_NAME=Your Company
PUBLIC_APP_URL=http://localhost:3000                # https://mail.company.co.tz in production
SEED_DEMO=1                                         # 0 in production: no demo users or fake mailboxes
FRONTEND_PORT=3000                                  # 127.0.0.1:3000 in production (behind Nginx only)

# --- Mail platform ------------------------------------------------------------------------------------
# REQUIRED IN PRODUCTION. Comma separated Fernet keys, newest first (rotate: prepend new key, run
# `python manage.py rotate_mail_keys`, then drop the old key). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAIL_TOKEN_KEYS=
MAIL_ENABLE_FAKE_PROVIDER=true                      # false in production
MAIL_INITIAL_SYNC_DAYS=90
MAIL_INITIAL_SYNC_MAX_THREADS=3000
MAIL_INVITE_TTL_HOURS=72
MAIL_BODY_CACHE_DAYS=14
MAIL_MAX_ATTACHMENT_BYTES=26214400
MAIL_RATE_PER_SECOND=15

# --- Google OAuth (docs/google-setup.md) --------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Defaults to ${PUBLIC_APP_URL}/api/v1/mail/oauth/callback/ — must match the URI registered in Google Cloud.
GOOGLE_OAUTH_REDIRECT_URI=
# GOOGLE_OAUTH_SCOPES=openid,https://www.googleapis.com/auth/userinfo.email,https://mail.google.com/,https://www.googleapis.com/auth/gmail.settings.basic

# --- Production hardening -----------------------------------------------------------------------------
SECURE_HSTS_SECONDS=2592000
