# Copy to .env (never commit .env). Every value here is optional for local `docker compose up`;
# the ones marked REQUIRED IN PRODUCTION must be set when DJANGO_SETTINGS_MODULE=config.settings.prod.

# --- Django -------------------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev          # config.settings.prod on the server
DJANGO_SECRET_KEY=                                  # REQUIRED IN PRODUCTION: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend    # add your domain, e.g. mail.company.co.tz
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000   # https://mail.company.co.tz in production
COOKIE_SECURE=false                                 # prod settings force secure cookies
SESSION_COOKIE_AGE=43200
TIME_ZONE=Africa/Dar_es_Salaam
LOG_LEVEL=INFO
GUNICORN_WORKERS=3
CELERY_CONCURRENCY=2

# --- Database / Redis (docker-compose builds DATABASE_URL and REDIS_URL from these) --------------------
POSTGRES_USER=cm
POSTGRES_PASSWORD=cm                                # REQUIRED IN PRODUCTION: a strong password
POSTGRES_DB=cm
# DATABASE_URL=postgres://cm:cm@127.0.0.1:5432/cm   # manual (non-Docker) setup only
# REDIS_URL=redis://127.0.0.1:6379/0                # manual setup; empty = tasks run inline, no worker needed

# --- Product ------------------------------------------------------------------------------------------
COMPANY_NAME=Your Company
PUBLIC_APP_URL=http://localhost:3000                # https://mail.company.co.tz in production
SEED_DEMO=1                                         # 0 in production: no demo users or fake mailboxes
FRONTEND_PORT=3000                                  # 127.0.0.1:3000 in production (behind Nginx only)

# --- Mail platform ------------------------------------------------------------------------------------
# REQUIRED IN PRODUCTION. Comma separated Fernet keys, newest first (rotate: prepend new key, run
# `python manage.py rotate_mail_keys`, then drop the old key). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAIL_TOKEN_KEYS=
MAIL_ENABLE_FAKE_PROVIDER=true                      # false in production
MAIL_INITIAL_SYNC_DAYS=90
MAIL_INITIAL_SYNC_MAX_THREADS=3000
MAIL_INVITE_TTL_HOURS=72
MAIL_BODY_CACHE_DAYS=14
MAIL_MAX_ATTACHMENT_BYTES=26214400
MAIL_RATE_PER_SECOND=15

# --- Google OAuth (docs/google-setup.md) --------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Defaults to ${PUBLIC_APP_URL}/api/v1/mail/oauth/callback/ — must match the URI registered in Google Cloud.
GOOGLE_OAUTH_REDIRECT_URI=
# GOOGLE_OAUTH_SCOPES=openid,https://www.googleapis.com/auth/userinfo.email,https://mail.google.com/,https://www.googleapis.com/auth/gmail.settings.basic

# --- Phones and the SMS platform (docs/sms-mobile.md) -------------------------------------------------
# REQUIRED IN PRODUCTION. Fernet keys for SMS bodies and MMS files, newest first, separate from MAIL_TOKEN_KEYS.
# Rotate: prepend a new key, run `python manage.py rotate_sms_keys`, then drop the old key.
SMS_DATA_KEYS=
SMS_MEDIA_ROOT=/data/sms-media                     # encrypted MMS files; private, outside any web root
SMS_INITIAL_SYNC_DAYS=90                           # history copied when a phone enrolls
SMS_ENROLL_TTL_HOURS=24                            # enrollment QR / code lifetime (single use)
SMS_DEVICE_TOKEN_TTL=15                            # minutes; phones mint new tokens with their Keystore key
SMS_MIN_APP_VERSION=1.0.0                          # older apps get 426 upgrade_required
SMS_REQUIRE_KEY_ATTESTATION=false                  # true: refuse phones without a hardware-backed, attested key
SMS_ATTESTATION_ROOTS_FILE=                        # PEM bundle of Google's attestation roots (needed when the above is true)
SMS_REQUIRE_PLAY_INTEGRITY=false                   # true: refuse phones failing Play Integrity (needs the next three)
PLAY_INTEGRITY_PACKAGE_NAME=
PLAY_INTEGRITY_SERVICE_ACCOUNT_FILE=               # mounted secret
PLAY_INTEGRITY_CERT_DIGESTS=                       # base64 SHA-256 of your APK signing cert(s), for private builds
SMS_OUTBOUND_TTL_HOURS=24                          # admin messages not sent by then expire instead of going out late
SMS_DEVICE_DAILY_CAP=300                           # admin messages per phone per day (protects the SIM from carrier blocks)
SMS_DEVICE_RATE_PER_MINUTE=20
SMS_USER_RATE_PER_MINUTE=30
SMS_ALLOW_SHORT_CODES=false                        # short codes can be premium-rate
SMS_RETENTION_DAYS=365                             # 0 = keep forever (document your PDPA reasoning first)
SMS_MIRROR_DEVICE_DELETES=false                    # true: deleting on the phone also deletes the server copy
SMS_DEFAULT_REGION=TZ                              # for numbers without a country code
SMS_SHOW_ADMIN_NAME_ON_PHONE=true                  # "Sent by admin · Name" on the phone
SMS_DEVICE_POLL_SECONDS=20                         # phone poll interval when FCM is not configured
SMS_ENABLE_SIMULATOR=true                          # simulated demo phones; false in production (prod refuses true)
FCM_PROJECT_ID=                                    # optional: Firebase wake-ups (near-instant delivery)
FCM_SERVICE_ACCOUNT_FILE=                          # mounted secret, e.g. /run/secrets/fcm.json

# --- Production hardening -----------------------------------------------------------------------------
SECURE_HSTS_SECONDS=2592000
