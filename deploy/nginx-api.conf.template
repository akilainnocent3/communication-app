# Optional: a separate domain for the phones (e.g. communicationapi.example.co.tz). It exposes ONLY /api/v1/device/;
# the admin API stays behind Next.js on the admin domain (nginx.conf.template). Render with
#   sudo CM_API_DOMAIN=api.example.co.tz deploy/render-nginx.sh api
# The cm_device zone and the header maps are defined in the admin template, which must be installed too.

server {
    listen 80;
    listen [::]:80;
    server_name ${CM_API_DOMAIN};
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${CM_API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${CM_API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CM_API_DOMAIN}/privkey.pem;
    server_tokens off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options $cm_nosniff always;
    add_header Referrer-Policy $cm_referrer always;
    add_header X-Frame-Options $cm_frame always;

    location /api/v1/device/ {
        limit_req zone=cm_device burst=40 nodelay;
        limit_req_status 429;
        client_max_body_size 2m;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie "";
        proxy_read_timeout 60s;
    }

    location / {
        return 404;
    }
}
